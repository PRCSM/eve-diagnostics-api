# Copy to .env for local development. Never commit a real .env.
# Values here are development-only placeholders.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Secure cookies/HTTPS settings (enable in production behind TLS)
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

# --- PostgreSQL ---
POSTGRES_DB=eve
POSTGRES_USER=eve
POSTGRES_PASSWORD=eve-dev-password
# 127.0.0.1 when running Django on your machine (avoids slow IPv6 "localhost" lookups on
# Windows); docker-compose overrides this to "db" for the api container.
POSTGRES_HOST=127.0.0.1
# Host port for the compose database (5433 avoids clashing with a locally installed Postgres).
POSTGRES_PORT=5433

# --- Auth ---
JWT_SIGNING_KEY=dev-only-insecure-jwt-signing-key-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Payments ---
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Used when POST /payments/ omits simulate_outcome: SUCCESS | FAILED | PENDING
PAYMENT_SIMULATION_DEFAULT_OUTCOME=SUCCESS

# --- Bookings ---
BOOKING_MAX_ADVANCE_DAYS=90

# --- Observability / docs ---
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console
API_DOCS_ENABLED=true
